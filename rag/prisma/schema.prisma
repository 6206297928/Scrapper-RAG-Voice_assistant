  SUBSCRIPTION_DOWNGRADED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_EXPIRING_SOON
  SUBSCRIPTION_EXPIRED
  TRIAL_ENDING_SOON
  TRIAL_ENDED
  PAYMENT_RECEIPT
  PAYMENT_FAILED
  INVOICE_AVAILABLE
  PAYMENT_METHOD_EXPIRING
  USAGE_WARNING_80
  USAGE_LIMIT_REACHED
  NEW_LEAD_NOTIFICATION
  DAILY_LEAD_DIGEST
  WEEKLY_LEAD_DIGEST
  MAINTENANCE_SCHEDULED
  FEATURE_ANNOUNCEMENT
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  BOUNCED
}
