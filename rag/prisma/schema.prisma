enum AuditCategory {
  AUTHENTICATION
  ACCOUNT
  BILLING
  BOT_CONFIG
  LEADS
  WIDGET
  SECURITY
  SYSTEM
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  PAYPAL
  OTHER
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum NotificationType {
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_CANCELED
  TRIAL_ENDING
  TRIAL_ENDED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_METHOD_EXPIRING
  INVOICE_AVAILABLE
  USAGE_80_PERCENT
  USAGE_100_PERCENT
  USAGE_OVERAGE
  NEW_LEAD
  DAILY_LEAD_SUMMARY
