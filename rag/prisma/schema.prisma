  USER_EMAIL_VERIFIED
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_DELETED
  API_KEY_REGENERATED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_RENEWED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  BOT_CONFIG_CREATED
  BOT_CONFIG_UPDATED
  BOT_CONFIG_DELETED
  BOT_CONFIG_PUBLISHED
  BOT_CONFIG_ACTIVATED
  BOT_CONFIG_DEACTIVATED
  BOT_CONFIG_ROLLBACK
  LEAD_STATUS_CHANGED
  LEAD_EXPORTED
  LEAD_DELETED
  WIDGET_SCRIPT_GENERATED
  WIDGET_SETTINGS_UPDATED
  SUSPICIOUS_ACTIVITY
  RATE_LIMIT_EXCEEDED
  INVALID_API_KEY_USED
  DOMAIN_BLOCKED
